DATABASE_URL="postgresql://user:password@localhost:5432/blindspot?schema=public"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
SMTP_URL=""
SMTP_FROM="Blindspot <no-reply@yourdomain.com>"
# Outreach drafts (src/lib/llm.ts). Defaults to OpenRouter.
# Local llama.cpp instead: LLM_BASE_URL="http://127.0.0.1:8080/v1", LLM_MODEL="<served model name>"
# LLM_API_KEY is the bearer token for whatever LLM_BASE_URL points at
# (OpenRouter key, Unsloth Studio key, …) — keyless local servers need none.
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""
OPENROUTER_API_KEY=""
